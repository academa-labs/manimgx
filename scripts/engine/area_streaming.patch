+// Stream a clipped polygon into its area integral: its first/previous input vertices and
+// first/previous output vertices are enough, regardless of the number of intersections.
+struct ClippedArea {
+    first: vec2<f32>,
+    previous: vec2<f32>,
+    begin: vec2<f32>,
+    end: vec2<f32>,
+    area: f32,
+    started: bool,
+    emitted: bool,
+};
+
+fn area_vertex(point: vec2<f32>, state: ptr<function, ClippedArea>) {
+    if (!(*state).emitted) {
+        (*state).begin = point;
+        (*state).emitted = true;
+    }
+    let last = (*state).end;
+    (*state).area += last.x * point.y - point.x * last.y;
+    (*state).end = point;
+}
+
+fn clipped_vertex(point: vec2<f32>, line: vec3<f32>, state: ptr<function, ClippedArea>) {
+    if ((*state).started) {
+        let previous = (*state).previous;
+        let a = dot(previous, line.xy) - line.z;
+        let b = dot(point, line.xy) - line.z;
+        if (a >= 0.0) {
+            area_vertex(previous, state);
+        }
+        if ((a >= 0.0) != (b >= 0.0)) {
+            area_vertex(previous + (point - previous) * (a / (a - b)), state);
+        }
+    } else {
+        (*state).first = point;
+        (*state).started = true;
+    }
+    (*state).previous = point;
+}
+
+fn intersect_area_edge(p: vec2<f32>, q: vec2<f32>, first: vec3<f32>, second: vec3<f32>, state: ptr<function, ClippedArea>) {
+    let a = dot(p, first.xy) - first.z;
+    let b = dot(q, first.xy) - first.z;
+    if (a >= 0.0) {
+        clipped_vertex(p, second, state);
+    }
+    if ((a >= 0.0) != (b >= 0.0)) {
+        clipped_vertex(p + (q - p) * (a / (a - b)), second, state);
+    }
+}
